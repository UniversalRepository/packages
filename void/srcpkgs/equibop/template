# Template file for 'equibop'
pkgname=equibop
version=3.3.2
revision=1
_bun_version=1.4.4
_electron_version=44.9.3
archs="x86_64* aarch64*"
create_wrksrc=yes
build_wrksrc="Equibop-${version}"
hostmakedepends="clang23 llvm23 lld23 cmake ninja nodejs pkg-config python3 unzip"
makedepends="libglib-devel nodejs-devel pipewire-devel pulseaudio-devel"
depends="hicolor-icon-theme libnotify xdg-utils"
short_desc="Discord desktop client with Equicord and improved Linux support"
maintainer="Haris <plavpxl@proton.me>"
license="GPL-3.0-or-later"
homepage="https://github.com/Equicord/Equibop"
changelog="https://github.com/Equicord/Equibop/releases"
nocross=yes
nostrip=yes
noshlibprovides=yes

build_options="system_electron"
build_options_default="system_electron"
desc_option_system_electron="Use system Electron 35 instead of bundled Electron"

if [ "$build_option_system_electron" ]; then
	depends+=" electron35"
fi

case "$XBPS_MACHINE" in
	x86_64)
		_bun_arch=x64-baseline
		_bun_checksum=e0446eb55995772eb9894bebae9a6be368d985a8b9271ee124486f9946eedd76 ;;
	x86_64-musl)
		_bun_arch=x64-musl-baseline
		_bun_checksum=6e9c37098b293920aed28bfb51ab240e26d23bfdd9bbfecb3ad428ac166549bc ;;
	aarch64)
		_bun_arch=aarch64
		_bun_checksum=baa6bb36f51d6e58561e02bbea825038a9df454f673d6d776e8bbf86f8c7850e ;;
	aarch64-musl)
		_bun_arch=aarch64-musl
		_bun_checksum=57f01b02ac7113c61c935f28f38c2eab849e3c970dab21f8b640a87b1ef65009 ;;
esac

distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz>equibop-${version}.tar.gz
 https://github.com/oven-sh/bun/releases/download/bun-v${_bun_version}/bun-linux-${_bun_arch}.zip>bun-${_bun_version}-${_bun_arch}.zip
 https://github.com/Vencord/venmic/archive/refs/tags/v7.2.3.tar.gz>venmic-7.2.3.tar.gz
 https://github.com/Curve/rohrkabel/archive/refs/tags/v13.1.1.tar.gz>rohrkabel-13.1.1.tar.gz
 https://github.com/Curve/channel/archive/refs/tags/v4.0.0.tar.gz>channel-4.0.0.tar.gz
 https://github.com/Curve/coco/archive/refs/tags/v4.7.2.tar.gz>coco-4.7.2.tar.gz
 https://github.com/Curve/ereignis/archive/refs/tags/v6.3.0.tar.gz>ereignis-6.3.0.tar.gz
 https://github.com/stephenberry/glaze/archive/refs/tags/v7.9.1.tar.gz>glaze-7.9.1.tar.gz
