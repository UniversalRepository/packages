 https://github.com/cpm-cmake/CPM.cmake/releases/download/v0.43.1/CPM.cmake>CPM-0.43.1.cmake"
checksum="81a5967f696f4ccf218f8b625623f54d043c676024cdcc29a574431d89922d3d
 ${_bun_checksum}
 5bed271f1777e5e794273899a590e7f511e6131a8122e3c83f85bc3bf22cfc50
