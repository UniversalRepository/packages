skip_extraction="CPM-0.43.1.cmake"

if [ ! "$build_option_system_electron" ]; then
	if [ "$XBPS_TARGET_LIBC" = musl ]; then
		broken="Bundled Electron is glibc-only, enable system_electron for musl"
	fi
	case "$XBPS_TARGET_MACHINE" in
		x86_64*)
			_electron_arch=x64
			_electron_checksum=6e7fd2d450d442507b846ace4ae6e2bd17e1b1653e86a033b5231abfc23e6df4 ;;
		aarch64*)
			_electron_arch=arm64
			_electron_checksum=8e70d53d920d84db869023280e5a1fbda82ecc58fea4443748e58309a3c80238 ;;
	esac
	_electron_zip="electron-v${_electron_version}-linux-${_electron_arch}.zip"
	distfiles+=" https://github.com/electron/electron/releases/download/v${_electron_version}/${_electron_zip}"
	checksum+=" ${_electron_checksum}"
	skip_extraction+=" ${_electron_zip}"
fi

post_extract() {
	local dep
	for dep in venmic-7.2.3 rohrkabel-13.1.1 channel-4.0.0 coco-4.7.2 ereignis-6.3.0; do
		vsrccopy CPM-0.43.1.cmake "${dep}/cmake"
		mv "${dep}/cmake/CPM-0.43.1.cmake" "${dep}/cmake/cpm.cmake"
	done
	if [ ! "$build_option_system_electron" ]; then
		mkdir electron-dist
		vsrcextract -C electron-dist --no-strip-components "${_electron_zip}"
	fi
}

post_patch() {
	if [ "$build_option_system_electron" ]; then
		patch -Np1 -i "${FILESDIR}/electron35.patch"
	fi
}

do_configure() {
	export PATH="${wrksrc}/bun-linux-${_bun_arch}:$PATH"
	export CC=/usr/lib/llvm/23/bin/clang
	export CXX=/usr/lib/llvm/23/bin/clang++
	export ELECTRON_SKIP_BINARY_DOWNLOAD=1

	bun install --frozen-lockfile --ignore-scripts
	(
		cd packages/libvesktop
		bun install --frozen-lockfile --ignore-scripts
		node node_modules/node-gyp/bin/node-gyp.js configure --nodedir=/usr --enable-lto=false
	)

	cmake -S "${wrksrc}/venmic-7.2.3" -B "${wrksrc}/build-venmic" -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_CXX_COMPILER="$CXX" \
		-DCMAKE_CXX_FLAGS="${CPPFLAGS} ${CXXFLAGS}" \
		-DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}" \
		-DCMAKE_JS_VERSION=7 -Dvenmic_addon=ON -DBUILD_SHARED_LIBS=OFF \
		-DCMAKE_JS_INC="/usr/include/node;${PWD}/node_modules/node-addon-api" \
		-Dchannel_install=OFF -Dcoco_install=OFF -Dglaze_INSTALL=OFF \
		-DSPDLOG_INSTALL=OFF -DCPM_LOCAL_PACKAGES_ONLY=ON \
		-DCPM_rohrkabel_SOURCE="${wrksrc}/rohrkabel-13.1.1" \
		-DCPM_channel_SOURCE="${wrksrc}/channel-4.0.0" \
		-DCPM_coco_SOURCE="${wrksrc}/coco-4.7.2" \
		-DCPM_ereignis_SOURCE="${wrksrc}/ereignis-6.3.0" \
		-DCPM_glaze_SOURCE="${wrksrc}/glaze-7.9.1" \
		-DCPM_spdlog_SOURCE="${wrksrc}/spdlog-1.17.0"
}

do_build() {
	export PATH="${wrksrc}/bun-linux-${_bun_arch}:$PATH"
	export CC=/usr/lib/llvm/23/bin/clang
	export CXX=/usr/lib/llvm/23/bin/clang++
	(
		cd packages/libvesktop
		node node_modules/node-gyp/bin/node-gyp.js build --jobs="${XBPS_MAKEJOBS}"
	)
	cmake --build "${wrksrc}/build-venmic" -- ${makejobs}

	rm -f static/dist/*.node static/dist/arrpc-*
	cp packages/libvesktop/build/Release/vesktop.node "static/dist/libvesktop-${_arch_node}.node"
	cp "${wrksrc}/build-venmic/addon/venmic-addon.node" "static/dist/venmic-${_arch_node}.node"
	${STRIP} --strip-unneeded static/dist/*.node
	bun run build

	mkdir -p app-build build-output/resources/arrpc		
	bun build --compile --minify node_modules/arrpc-bun/src/index.ts --outfile build-output/resources/arrpc/arrpc
	cp -R dist static package.json LICENSE app-build/
	node node_modules/@electron/asar/bin/asar.js pack app-build build-output/resources/app.asar --unpack '**/*.node'
}

case "$XBPS_TARGET_MACHINE" in
	x86_64*) _arch_node=x64 ;;
	aarch64*) _arch_node=arm64 ;;
esac

do_install() {
	vmkdir usr/lib/equibop
	if [ "$build_option_system_electron" ]; then
		vcopy build-output/resources usr/lib/equibop
		vbin "${FILESDIR}/equibop-system-electron" equibop
	else
		vcopy "${wrksrc}/electron-dist/*" usr/lib/equibop
		rm -f "${DESTDIR}/usr/lib/equibop/resources/default_app.asar"
		vcopy "build-output/resources/*" usr/lib/equibop/resources
		chmod 4755 "${DESTDIR}/usr/lib/equibop/chrome-sandbox"
		vbin "${FILESDIR}/equibop" equibop
	fi
	vinstall "${FILESDIR}/equibop.desktop" 644 usr/share/applications
	vinstall build/icon.svg 644 usr/share/icons/hicolor/scalable/apps equibop.svg
}
