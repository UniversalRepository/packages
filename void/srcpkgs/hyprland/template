# Template file for 'hyprland'
pkgname=hyprland
version=0.57.0
revision=1
archs="x86_64"
build_style=cmake
configure_args="-DNO_SYSTEMD=ON -DUSE_NATIVE_EMBED=OFF -DCMAKE_BUILD_TYPE=Release -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON"
hostmakedepends="cmake pkg-config autoconf git cpio glslang jq make ninja lua55 clang21"
makedepends="
	aquamarine-devel
	abseil-cpp-devel
	cairo-devel
	glslang
	hwids
	hyprcursor-devel
	hyprgraphics
	hyprlang-devel
	hyprland-guiutils
	hyprland-protocols
	hyprutils-devel
	hyprwayland-scanner
	hyprwire
	lcms2-devel
	libdisplay-info-devel
	libdrm-devel
	libei-devel
	libgbm-devel
	libglvnd-devel
	libinput-devel
	libliftoff-devel
	libseat-devel
	libxcb-devel
	libXcursor-devel
	libxkbcommon-devel
	lua55-devel
	muparser-devel
	re2-devel
	readline-devel
	SPRIV-Tools-devel
	tomlplusplus-devel
	pango-devel
	wayland-devel
	wayland-protocols
	udis86-devel
	xcb-util-errors-devel
	xcb-util-renderutil-devel
	xcb-util-wm-devel
	xcb-util-image-devel
	xorg-server-xwayland
"
depends="
	cairo
	glslang
	hyprcursor
	hyprgraphics
	hyprlang
	hyprwayland-scanner
	hyprutils
	lcms2
	libliftoff
	libxcb
	libXfixes
	muparser
	polkit
	re2
	vulkan-loader
	Vulkan-ValidationLayers
	wayland
	wayland-protocols
	xcb-protu
	xcb-util
	xcb-util-keysyms
	xorg-server-xwayland
"
short_desc="Highly customizable dynamic tiling Wayland compositor"
maintainer="Rain Xelelo <rxelelo@outlook.com>"
license="BSD-3-Clause"
homepage="https://hyprland.org/"
changelog="https://github.com/hyprwm/Hyprland/releases"
distfiles="${changelog}/download/v${version}/source-v${version}.tar.gz"

if [ "$XBPS_TARGET_LIBC" = "glibc" ]; then
	makedepends+=" glaze"
fi

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
	configure_args+=" -DCMAKE_CXX_FLAGS=\"-lexecinfo\""
	makedepends+=" libexecinfo-devel"
	depends+=" libexecinfo"
fi

pre_confiugre() {
	export CC=clang
	export CXX=clang++
	configure_args+=" -DCMAKE_C_COMPILER=$CC -DCMAKE_CXX_COMPILER=$CXX \
		-DCMAKE_CXX_STANDARD=23 -DCMAKE_CXX_STANDARD_REQUIRED=ON \
		-DCMAKE_CXX_FLAGS=-stdlib=libstdc++ \
		-DCMAKE_EXE_LINKER_FLAGS=-stdlib=libstdc++ \
		-DCMAKE_SHARED_LINKER_FLAGS=-stdlib=libstdc++"
}

post_install() {
	vlicense LICENSE
	vinstall ${wrksrc}/build/hyprland.pc 644 usr/share/pkgconfig
	vinstall ${wrksrc}/build/hyprland.pc 644 usr/lib/pkgconfig
}

hyprland-devel_package() {
	short_desc="Dynamic tiling Wayland compositor - development files"
	depends="${sourcepkg}>=${version}_${revision} ${makedepends}"
	pkg_install() {
		vmove usr/include
		vmove usr/share/pkgconfig
		make -C ${wrksrc} installheaders PREFIX=/usr DESTDIR=${DESTDIR}
	}
}
