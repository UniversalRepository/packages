# Template file for 'nightcap'
pkgname=nightcap
version=0.5.1
revision=1
build_style=cmake
configure_args="-DCMAKE_INSTALL_LIBDIR=lib
 -DBUILD_TESTING=OFF -DFETCHCONTENT_FULLY_DISCONNECTED=ON
 -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF
 -DMOCKTAIL_BUILD_FREEBSD_SOCKET_HELPER=OFF
 -DMOCKTAIL_DEFAULT_COMPATIBILITY_MANIFEST=/usr/share/mocktail/metadata/roblox_compatibility.json
 -DMOCKTAIL_DEFAULT_SIGNING_TRUST_MANIFEST=/usr/share/mocktail/metadata/roblox_signing_certificates.json"
hostmakedepends="cmake git ninja pkg-config"
makedepends="SDL3-devel SDL3_ttf-devel capstone-devel elfutils-devel
 ffmpeg6-devel fontconfig-devel gtk4-devel json-c++ libadwaita-devel
 libcurl-devel libglib-devel libglvnd-devel libplacebo-devel libpng-devel
 libsecret-devel libutf8proc-devel libwebkitgtk60-devel libyaml-devel
 linux-headers minizip-devel openssl-devel vulkan-loader-devel zlib-devel"
depends="ca-certificates hicolor-icon-theme libglvnd libavcodec6
 libavutil6 vulkan-loader xdg-utils"
short_desc="Android Roblox compatibility runtime with desktop improvements"
maintainer="URepo <orphaned@universalrepo.pages.dev>"
license="Apache-2.0"
homepage="https://github.com/CoderDayton/nightcap"
changelog="https://github.com/CoderDayton/nightcap/releases"
noshlibprovides=yes
# tests fetch Google Test
make_check=no

do_fetch() {
	git clone --jobs ${XBPS_MAKEJOBS} --depth=1 --branch "v${version}" --recurse-submodules --shallow-submodules "${homepage}.git" "$wrksrc"
}

post_install() {
	vlicense LICENSE
}
