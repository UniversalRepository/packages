#!/usr/bin/env bash
set -euo pipefail

case ${BASH_SOURCE[0]} in
    /*) UREPO_ROOT=${BASH_SOURCE[0]} ;;
    */*) UREPO_ROOT=./${BASH_SOURCE[0]} ;;
    *) UREPO_ROOT=$(command -v "${BASH_SOURCE[0]}") ;;
esac

UREPO_ROOT=$(CDPATH= cd -P "$(dirname "$UREPO_ROOT")" && pwd -P)
export UREPO_ROOT

. "$UREPO_ROOT/src/cli.sh"
. "$UREPO_ROOT/src/distro.sh"

main "$@"
